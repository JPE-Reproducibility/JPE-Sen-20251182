*******************************************************************************
* 11_intext_numbers.do
* Computes the numbers quoted in the text and footnotes of the paper that are
* not read directly off a table or figure, and writes them to
*   $OUT/intext_numbers.txt
* Each line: location in paper | description | value from this run | value
* printed in the paper (October 2026 version), for easy comparison.
*
* Inputs : $TEMP/survey.dta, $TEMP/panel.dta, $TEMP/purecontrol_attempt.dta,
*          $TEMP/survey_original_and_followup_joined.dta,
*          $TEMP/followup_balance_stats.dta (12), $TEMP/appendixE_stats.dta (13)
* Paths  : $RAW, $TEMP, $OUT are set in code/MASTER.do
*******************************************************************************

clear all
set more off

capture file close itn
file open itn using "$OUT/intext_numbers.txt", replace write text
file write itn "In-text numbers: GenAI Misinformation, Trust, and News Consumption" _n
file write itn "Generated by code/11_intext_numbers.do on `c(current_date)' `c(current_time)'" _n
file write itn "Columns: location | description | value (this run) | value printed in paper" _n
file write itn _dup(100) "-" _n

capture program drop put
program define put
    args loc desc val paper
    file write itn "`loc' | `desc' | `val' | `paper'" _n
    display as text "`loc' | `desc' | " as result "`val'" as text " | paper: `paper'"
end

* ---------------------------------------------------------------------------
* A. Survey sample (completed surveys)
* ---------------------------------------------------------------------------
use "$TEMP/survey.dta", clear

quietly count if completed == "ja"
local v : display %9.0fc r(N)
put "Sec 1 / Sec 4.2" "Survey sample: completed surveys (N)" "`=trim("`v'")'" "more than 17,000 (Table A.2: 17,199)"

quietly count if tracked == 1
local v : display %9.0fc r(N)
put "Sec 1 / Sec 4.2" "Tracked sample (survey respondents matched to SZ records, N)" "`=trim("`v'")'" "about 6,000 (Table 4: 6,158)"

* Footnote 5: trust in SZ, control group (all respondents with an answer)
quietly sum trustnum_SZ if treatment == 0
local v : display %4.2f r(mean)
put "Fn 5" "Control group: mean trust in SZ (0-3)" "`v'" "2.9"
quietly count if treatment == 0 & trustnum_SZ < .
local nC = r(N)
quietly count if treatment == 0 & trustnum_SZ == 3
local v : display %4.1f 100 * r(N) / `nC'
put "Fn 5" "Control group: % reporting maximum trust in SZ (=3)" "`v'%" "92%"
quietly count if treatment == 0 & trustnum_SZ < 2
local v : display %4.2f 100 * r(N) / `nC'
put "Fn 5" "Control group: % reporting trust in SZ below 2" "`v'%" "0.6%"

* Footnote 7 and Section 4.1: quiz performance
quietly sum correct if treatment == 1
local v : display %4.2f r(mean)
put "Fn 7" "Treatment: mean number of correct answers (0-3)" "`v'" "0.9"
quietly count if treatment == 1 & correct < .
local nT = r(N)
quietly count if treatment == 1 & correct == 3
local v : display %4.1f 100 * r(N) / `nT'
put "Fn 7" "Treatment: % answering all three correctly" "`v'%" "about 2.5%"
quietly count if treatment == 1 & correct == 0
local v : display %4.1f 100 * r(N) / `nT'
put "Fn 7" "Treatment: % answering all three wrong" "`v'%" "36%"

* share of correct responses over all answered questions (treatment)
preserve
keep if treatment == 1
keep Q1_correct Q2_correct Q3_correct
gen long obs = _n
reshape long Q@_correct, i(obs) j(q)
quietly sum Q_correct
local v : display %4.1f 100 * r(mean)
put "Sec 4.1" "Treatment: % correct responses (all answered questions)" "`v'%" "29%"
forvalues q = 1/3 {
    quietly sum Q_correct if q == `q'
    local v : display %4.1f 100 * r(mean)
    put "Fn 32" "Treatment: % correct, picture pair `q' (1 climate, 2 politicians, 3 protest)" "`v'%" "20% / 36% / 30%"
}
restore

quietly sum hard if treatment == 1
local v : display %4.2f r(mean)
put "Sec 4.1" "Treatment: mean perceived difficulty (0-6)" "`v'" "4.7"
quietly sum hard if treatment == 0
local v : display %4.2f r(mean)
put "Sec 4.1" "Control: mean perceived difficulty (0-6)" "`v'" "1.52"

preserve
keep if treatment == 0
keep Q1_correct Q2_correct Q3_correct correct
gen long obs = _n
quietly count if correct < .
local nC = r(N)
quietly count if correct == 3
local v : display %4.1f 100 * r(N) / `nC'
put "Sec 4.1" "Control: % answering all three correctly" "`v'%" "72%"
reshape long Q@_correct, i(obs) j(q)
quietly sum Q_correct
local v : display %4.1f 100 * r(mean)
put "Sec 4.1" "Control: % correct responses (all answered questions)" "`v'%" "89%"
restore

* Median completion time (completed surveys)
preserve
keep if completed == "ja"
gen dur_sec = real(substr(time_duration,1,2))*3600 + real(substr(time_duration,4,2))*60 + real(substr(time_duration,7,2))
foreach g in all 1 0 {
    if "`g'" == "all" quietly _pctile dur_sec, p(50)
    else              quietly _pctile dur_sec if treatment == `g', p(50)
    local m = r(r1)
    local mm = floor(`m' / 60)
    local ss : display %02.0f mod(`m', 60)
    local lab = cond("`g'"=="all", "all", cond("`g'"=="1", "treatment", "control"))
    local pap = cond("`g'"=="all", "4:06", cond("`g'"=="1", "4:20", "3:54"))
    put "Sec 4.1" "Median time to complete the survey (min:sec), `lab'" "`mm':`ss'" "`pap'"
}
restore

* Footnote 19: dates on which subscribers (email invitation) took the quiz
preserve
keep if subscriber == 1
gen qdate = date(substr(time_start,1,10), "DMY")
quietly count if qdate < .
local nS = r(N)
foreach d in 1 2 3 {
    quietly count if qdate == mdy(3, `d', 2025)
    local v : display %4.1f 100 * r(N) / `nS'
    local pap = cond(`d'==1, "71%", cond(`d'==2, "17%", "6%"))
    put "Fn 19" "Subscribers: % taking the quiz on March `d', 2025 (all respondents)" "`v'%" "`pap'"
}
restore

* Footnote 34: differential responses. Respondents were not required to answer
* any question (SZ protocol). In the focal analysis sample (completed surveys),
* proportions test, treatment vs control, of having answered both the first
* pre-intervention question (gender) and the final post-intervention question
* (WTP).
preserve
keep if completed == "ja" & treatment < .
gen answered_both = (gender != "" & wtp_subscription < .)
quietly prtest answered_both, by(treatment)
local v : display %4.2f 2 * normal(-abs(r(z)))
put "Fn 34" "Completed surveys: prop. test T vs C, answered gender and WTP (p-value)" "`v'" "0.66"
restore

* Section 4.2: shares in the survey sample (also in Table A.2)
preserve
keep if completed == "ja"
gen female = (gender == "Weiblich")
replace tracked = 0 if tracked == .
quietly sum female
local v : display %4.1f 100 * r(mean)
put "Sec 4.2" "Survey sample: % female" "`v'%" "about 45%"
quietly sum subscriber
local v : display %4.1f 100 * r(mean)
put "Sec 4.2" "Survey sample: % subscribers" "`v'%" "94%"
quietly sum tracked
local v : display %4.1f 100 * r(mean)
put "Sec 4.2" "Survey sample: % consenting to tracking (tracked)" "`v'%" "around 34%"
restore

* Footnote 38: distribution of misinformation concern
foreach g in 0 1 {
    quietly count if treatment == `g' & misinfo < .
    local n = r(N)
    quietly count if treatment == `g' & misinfo == 6
    local v6 : display %4.1f 100 * r(N) / `n'
    quietly count if treatment == `g' & misinfo == 5
    local v5 : display %4.1f 100 * r(N) / `n'
    local lab = cond(`g'==1, "Treatment", "Control")
    local pap = cond(`g'==1, "77% / 18%", "62% / 30%")
    put "Fn 38" "`lab': % misinfo concern = 6 / = 5" "`v6'% / `v5'%" "`pap'"
}

* Section 5.1: control-group mean trust by outlet
foreach o in SZ ARDZDF LI Bild IG TikTok X {
    quietly sum trustnum_`o' if treatment == 0
    local v : display %4.2f r(mean)
    local pap = cond("`o'"=="SZ","2.91",cond("`o'"=="ARDZDF","2.80",cond("`o'"=="LI","1.32",cond("`o'"=="Bild","0.82",cond("`o'"=="IG","0.76",cond("`o'"=="TikTok","0.26","0.25"))))))
    put "Sec 5.1" "Control: mean trust in `o' (0-3)" "`v'" "`pap'"
}

* Section 5.1: ATE on misinformation concern in SD units (as in Figure 2a)
preserve
keep if completed == "ja"
quietly sum misinfo if treatment == 0
local m0 = r(mean)
local s0 = r(sd)
quietly sum misinfo if treatment == 1
local m1 = r(mean)
local s1 = r(sd)
local v : display %4.2f (`m1' - `m0') / sqrt((`s0'^2 + `s1'^2) / 2)
put "Sec 5.1 / Abstract" "ATE on misinformation concern (SD units)" "`v'" "0.31 (about 0.3)"
restore

* ---------------------------------------------------------------------------
* B. Tracked sample: heterogeneity cut-offs
* ---------------------------------------------------------------------------
use "$TEMP/survey.dta", clear
keep if tracked == 1
quietly _pctile tvisits_pre, p(25 75)
local p25 = r(r1)
local p75 = r(r2)
put "Sec 5.2.2" "Tracked: 25th / 75th percentile of visits in the 3 pre-weeks" "`p25' / `p75'" "20 / 145"
quietly sum aff_politics
local v : display %4.1f 100 * r(mean)
local w : display %4.1f 100 * (1 - r(mean))
put "Sec 5.2.2" "Tracked (non-missing affinity): % high / low politics affinity" "`v'% / `w'%" "57% / 43%"

* Subscription: attrition at 5 months
quietly sum subscription_status_150 if treatment == 0
local a0 = 1 - r(mean)
quietly sum subscription_status_150 if treatment == 1
local a1 = 1 - r(mean)
local v0 : display %5.2f 100 * `a0'
local v1 : display %5.2f 100 * `a1'
local r  : display %4.2f (`a0' - `a1') / `a0'
put "Sec 5.3.1" "Attrition at 150 days, control / treatment (%)" "`v0'% / `v1'%" "-"
put "Sec 5.3.1 / Abstract" "Reduction in attrition rate (share of control attrition)" "`r'" "about 30% (Abstract, Sec 1); around 30% (Sec 5.3.1)"

quietly reg subscription_status_150 treatment, robust
local b150 = _b[treatment]
local v : display %5.2f 100 * `b150'
put "Sec 5.3.1 / Abstract" "Treatment effect on retention at 5 months (p.p.)" "`v'" "1.2"
quietly reg subscription_status_90 treatment, robust
local v : display %5.2f 100 * _b[treatment]
put "Fn 49" "Treatment effect on retention at 3 months (p.p.)" "`v'" "0.74"

* Back-of-the-envelope revenue calculation (Section 5.3.1)
local rev : display %12.0fc 129 * round(`b150', 0.001) * 295000
put "Sec 5.3.1" "Annual subscription revenue gain = 129 EUR x effect (rounded) x 295,000" "`=trim("`rev'")' EUR" "456,000 EUR"
local rev2 : display %12.0fc 129 * `b150' * 295000
put "Sec 5.3.1" "Same, using the unrounded 5-month coefficient" "`=trim("`rev2'")' EUR" "-"

* ---------------------------------------------------------------------------
* C. Panel: model-free comparison of visits, 5 days post-intervention
* ---------------------------------------------------------------------------
use "$TEMP/panel.dta", clear
drop if group == 0
preserve
keep if post == 1 & timesincequiz <= 5
quietly ttest visit_count, by(treatment)
local mC : display %4.2f r(mu_1)
local mT : display %4.2f r(mu_2)
local p  : display %5.3f r(p)
local d  : display %3.1f 100 * (r(mu_2) - r(mu_1)) / r(mu_1)
put "Sec 5.2.1" "Mean daily visits, days 1-5 post: treated / control" "`mT' / `mC'" "4.83 / 4.69"
put "Sec 5.2.1" "t-test p-value (treated vs control, days 1-5 post)" "`p'" "0.032"
put "Sec 5.2.1" "Difference in means relative to control (%)" "`d'%" "2.9%"
restore

* Effect relative to sample mean, Table 1 columns (1) and (2)
foreach t in 3 5 {
    quietly reghdfe visit_count treatment##post if timesincequiz>=-21 & timesincequiz<=`t', absorb(id date_panel) vce(cluster id)
    local b = _b[1.treatment#1.post]
    quietly sum visit_count if e(sample)
    local v : display %4.2f 100 * `b' / r(mean)
    put "Sec 1 / 5.2.1" "Visits effect relative to sample mean, window (-21;+`t') (%)" "`v'%" "about 2.5%"
}

* Politics-affinity split as a share of tracked individuals in the DiD sample
preserve
keep if timesincequiz >= -21 & timesincequiz <= 5 & aff_politics < .
bysort id: keep if _n == 1
quietly sum aff_politics
local v : display %4.1f 100 * r(mean)
local w : display %4.1f 100 * (1 - r(mean))
put "Sec 5.2.2" "DiD sample individuals: % high / low politics affinity" "`v'% / `w'%" "57% / 43%"
restore

* ---------------------------------------------------------------------------
* D. Alternative control group(s)
* ---------------------------------------------------------------------------
use "$TEMP/panel.dta", clear
keep if group == 0
egen byte _tag = tag(id)
quietly count if _tag
local n = r(N)
put "Sec 5.2.4" "No-quiz group in panel (group==0; incl. IDs from SZ tracking extracts without a survey record)" "`n'" "-"
quietly sum visit_count
local v : display %4.2f r(mean)
put "Sec 5.3.1" "Alternative control: mean daily visits (all days)" "`v'" "3.1"
quietly sum visit_count if date_panel <= td(28feb2025)
local v : display %4.2f r(mean)
put "Sec 5.3.1" "Alternative control: mean daily visits (pre-period, up to 28 Feb 2025)" "`v'" "3.1"

* Section 5.3.1 back-of-the-envelope calculations, using the rounded inputs
* stated in the text (3.1 daily visits, 2.5% visit effect, 295,000 subscribers)
local v : display %12.0fc 3.1 * 295000
put "Sec 5.3.1" "Daily visits by subscribers = 3.1 x 295,000" "`=trim("`v'")'" "at least 900,000"
local v : display %12.0fc 0.025 * 900000
put "Sec 5.3.1" "Additional daily visits = 0.025 x 900,000" "`=trim("`v'")'" "about 23,000"
local ret = `b150' * 295000
local v : display %12.0fc `ret'
put "Sec 5.3.1" "Retained subscribers = 5-month effect x 295,000" "`=trim("`v'")'" "about 3,500"
local v : display %5.2f round(`ret', 100) * 365 * 3.1 / 1e6
put "Sec 5.3.1" "Annual visits from retained subscribers = 3,500 x 365 x 3.1 (million)" "`v'" "over 3.9 million (Sec 1: over 3 million)"

* Section 5.2.4: size of the no-quiz alternative control group in the raw extract
preserve
import delimited "$RAW/SZAP-1385_ai_awareness_eval_daily_visits_super_control.csv", delimiter(",") varnames(1) clear
egen byte _tag = tag(anonymous_user_id)
quietly count if _tag
local v : display %9.0fc r(N)
put "Sec 5.2.4" "No-quiz alternative control: sampled subscribers with visits in the window" "`=trim("`v'")'" "2,344 (of 3,000 drawn)"
restore

use "$TEMP/purecontrol_attempt.dta", clear
quietly count if purecontrol == 1 & visit_count > 234 & visit_count < .
put "Sec 5.3.2" "Highly engaged non-respondents (>234 visits, 8-28 Feb 2025)" "`r(N)'" "479 (text: at least 234 visits in February 2025)"
quietly _pctile visit_count if treatment == 1, p(90)
local v : display %6.0f r(r1)
put "Sec 5.3.2" "Treatment group: 90th percentile of pre-period visits" "`=trim("`v'")'" "234 (top 10%)"

* ---------------------------------------------------------------------------
* E. Follow-up survey (Section 5.4)
* ---------------------------------------------------------------------------
use "$TEMP/survey_original_and_followup_joined.dta", clear
keep if responded_followup == 1
* one row per follow-up respondent (earliest original record; see 12)
gen double id_num = real(id)
sort id_followup id_num
by id_followup: keep if _n == 1
quietly count if treatment < .
local nlink = r(N)
quietly count if treatment == 0
local n0 = r(N)
quietly count if treatment == 1
local n1 = r(N)
put "Sec 5.4" "Follow-up respondents linked to original treatment status (control / treatment)" "`nlink' (`n0' / `n1')" "1,278 (655 / 623)"

import delimited "$RAW/follow_up_survey/followup_survey_english.csv", delimiter(";") varnames(1) encoding(UTF-8) stringcols(_all) clear
rename *, lower
drop if missing(id) | trim(id) == ""
put "Sec 5.4" "Follow-up survey respondents (N)" "`=_N'" "1,710"

* ---------------------------------------------------------------------------
* F. Footnote 53: selection into the follow-up survey (Table A.15; script 12)
* ---------------------------------------------------------------------------
use "$TEMP/followup_balance_stats.dta", clear
local v0 : display %4.1f 100 * rate_control[1]
local v1 : display %4.1f 100 * rate_treatment[1]
local p  : display %4.2f p_rate[1]
put "Fn 53" "Follow-up response rate (tracked sample), control / treatment (%); p-value" "`v0'% / `v1'%; p = `p'" "similar across arms (Table A.15: 21.2% / 20.1%; p = 0.330)"
put "Fn 53" "Panel B of Table A.15: differences significant at 5% / number of differences" "`=n_sig5[1]' / `=n_rows[1]'" "mostly balanced"
local p1 : display %4.2f p_joint_survey[1]
local p2 : display %4.2f p_joint_all[1]
put "Fn 53" "Joint tests of balance: survey characteristics / all characteristics (p-values)" "`p1' / `p2'" "0.25 / 0.83"

* ---------------------------------------------------------------------------
* G. Section 5.1, footnotes 41 and 59-60, Appendix E text (script 13)
* ---------------------------------------------------------------------------
use "$TEMP/appendixE_stats.dta", clear
local v : display %5.1f 100 * mult_SZ[1]
put "Sec 5.1 / App E" "Implied alpha_SZ / alpha_X, multiplicative model (%)" "`v'%" "about 5 percent"
local v : display %5.2f 100 * add_SZ[1]
put "Sec 5.1" "Implied alpha_SZ / alpha_X, additive model (%)" "`v'%" "as low as 0.5 percent"
local v1 : display %5.3f mult_ARDZDF[1]
local v2 : display %6.4f add_ARDZDF[1]
put "Sec 5.1 / App E" "Implied alpha_ARD/ZDF / alpha_X, multiplicative / additive" "`v1' / `v2'" "close to SZ"
local lo = min(mult_Bild[1], mult_IG[1], mult_TikTok[1])
local hi = max(mult_Bild[1], mult_IG[1], mult_TikTok[1])
local v : display %4.2f `lo' "-" %4.2f `hi'
put "Sec 5.1" "Implied alpha_i / alpha_X for Bild, Instagram, TikTok, multiplicative (range)" "`v'" "an order of magnitude higher than SZ"
local v : display %4.1f chi2_mult[1] " / " %4.1f chi2_add[1]
local w : display %8.1e p_mult[1] " / " %8.1e p_add[1]
put "Fn 41 / App E" "Wald chi2(5) symmetric misinformation, multiplicative / additive; p-values" "`v'; `w'" "30.0 / 41.4; 1.5e-05 / 7.8e-08 (rejected at 0.1%)"
local v : display %4.1f diff_hl[1] " log points, z = " %4.2f z_hl[1]
put "App E" "High- vs low-trust outlets: difference in mean log decline" "`v'" "7.7 log points (z = 4.70)"
local v : display %4.0f 100 * (1 - mult_SZ[1]) "% (" %2.0f 100 * (1 - mult_hi_SZ[1]) "-" %2.0f 100 * (1 - mult_lo_SZ[1]) "%)"
put "App E" "Share of X/Twitter's misinformation shock mitigated by SZ, multiplicative (95% interval)" "`v'" "about 95% (89-98%)"
local v : display %4.2f mult_hi_Bild[1] " / " %4.2f mult_hi_IG[1] " / " %4.2f mult_hi_TikTok[1]
put "App E" "Upper 95% bound of alpha_i/alpha_X (mult.): Bild / Instagram / TikTok" "`v'" "below one / below one / includes one"
local v : display %4.2f corrb_SZ_ARD[1]
put "Fn 59" "Correlation of estimated ATEs: SZ and ARD/ZDF" "`v'" "about 0.55"
local v : display %4.2f corrb_IG_TT[1] " / " %4.2f corrb_IG_X[1] " / " %4.2f corrb_TT_X[1]
put "Fn 59" "Correlation of estimated ATEs: IG-TikTok / IG-X / TikTok-X" "`v'" "0.3-0.4"
local v : display %4.2f corrb_maxcross[1]
put "Fn 59" "Correlation of estimated ATEs: largest |corr| between {SZ, ARD/ZDF} and other outlets" "`v'" "close to zero"
local v : display %4.2f corrl_SZ_ARD[1] " ; " %4.2f corrl_IG_TT[1] " / " %4.2f corrl_IG_X[1] " / " %4.2f corrl_TT_X[1] " ; " %4.2f corrl_maxcross[1]
put "Fn 59" "Same correlations for the log declines l_i (SZ-ARD ; IG-TT / IG-X / TT-X ; max cross)" "`v'" "-"
local v : display %9.0fc N_obs[1] " obs., " %9.0fc N_resp[1] " respondents"
put "App E (Table E.2 note)" "Stacked regression sample" "`=itrim(trim("`v'"))'" "98,074 obs., 17,294 respondents"

file write itn _dup(100) "-" _n
file write itn "Note: numbers that are taken directly from external sources (e.g., SZ circulation," _n
file write itn "subscription prices, Reuters Digital News Report figures, past SZ e-mail experiments)" _n
file write itn "are cited in the paper and are not computed here." _n
file close itn
display "Saved: $OUT/intext_numbers.txt"
