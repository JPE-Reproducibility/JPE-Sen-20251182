. * ---------------------------------------------------------------------------
. * 4. Start from a clean state: delete intermediate data and previous outputs
. * ---------------------------------------------------------------------------
. foreach ext in dta {
  2.     local fl : dir "$TEMP" files "*.`ext'"
  3.     foreach f of local fl {
  4.         erase "$TEMP/`f'"
  5.     }
  6. }

. foreach ext in tex pdf txt {
  2.     local fl : dir "$OUT" files "*.`ext'"
  3.     foreach f of local fl {
  4.         erase "$OUT/`f'"
  5.     }
  6. }

. 
