. local sd_s1 = "(" + string(r(sd), "%10.3fc") + ")"

. eststo r_s1: reghdfe ai_articles post if (date_clean >= mdy(2, 10, 2025) & date_clean <= mdy(3, 9, 2025)), absorb(
> week) vce(robust)
