  2.         local i = `d' / 30
  3.         quietly summarize subscription_status_`d'
  4.         local mean_y_`i' : display %10.3fc r(mean)
  5.         local sd_y_`i'   : display %10.3fc r(sd)
  6.         quietly reghdfe subscription_status_`d' i.treatment, vce(robust) noabs
  7.         eststo
  8.         local r2_`i' : display %10.4fc e(r2)
  9.         local N_`i'  : display %10.0fc e(N)
 10.         local F_`i'  : display %10.3fc e(F)
 11. }
