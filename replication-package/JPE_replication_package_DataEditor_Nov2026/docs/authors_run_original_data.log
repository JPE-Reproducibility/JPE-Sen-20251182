. * ============================================================
. * Figure: Misinfo ATE — Heterogeneity by Affinity and Reading Intensity
. * ============================================================
. use "$TEMP/survey.dta", clear

. {
. preserve
. keep if completed == "ja"
(2,449 observations deleted)
. 
. local cond1 "aff_politics==0"
. local cond2 "aff_politics==1"
. local cond3 "tvisits_pre<20  & tvisits_pre!=."
. local cond4 "tvisits_pre>145 & tvisits_pre!=."
. 
. forvalues i = 1/4 {
  2.     ttest misinfo if `cond`i'', by(treatment)
  3.     local pval_`i' : display %5.3f r(p)
  4. 
.     quietly summarize misinfo if (`cond`i'') & treatment == 0
  5.     local sd0   = r(sd)
  6.     local se0   = r(sd) / sqrt(r(N))
  7. 
.     quietly summarize misinfo if (`cond`i'') & treatment == 1
  8.     local sd1   = r(sd)
  9.     local se1   = r(sd) / sqrt(r(N))
 10.     local mu1   = r(mean)
 11. 
.     quietly summarize misinfo if (`cond`i'') & treatment == 0
 12.     local mu0   = r(mean)
 13. 
.     local psd        = sqrt((`sd0'^2 + `sd1'^2) / 2)
 14.     local theta_`i'  = (`mu1' - `mu0') / `psd'
 15.     local se_diff    = sqrt(`se0'^2 + `se1'^2) / `psd'
 16.     local cilo_`i'   = `theta_`i'' - invnormal(0.950) * `se_diff'
 17.     local cihi_`i'   = `theta_`i'' + invnormal(0.950) * `se_diff'
 18.     local efmt_`i'   : display %5.3f `theta_`i''
 19. }

