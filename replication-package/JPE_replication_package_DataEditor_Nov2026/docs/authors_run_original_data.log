  5.         local coef_d = _b[1.treatment]
  6.         local se_d   = _se[1.treatment]
  7.         local t_d    = `coef_d' / `se_d'
  8.         local p_d    = 2 * ttail(e(N) - 2, abs(`t_d'))
  9. 
.         local stars ""
